{
  "name": "ecosim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --outfile=node_modules/.cache/bench.cjs --log-level=error && node node_modules/.cache/bench.cjs",
    "check:worlds": "esbuild scripts/compare-check.ts --bundle --platform=node --outfile=node_modules/.cache/cmp.cjs --log-level=error && node node_modules/.cache/cmp.cjs",
    "learn:check": "esbuild scripts/learn-check.ts --bundle --platform=node --outfile=node_modules/.cache/learn-check.cjs --log-level=error && node node_modules/.cache/learn-check.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0"
  }
}
